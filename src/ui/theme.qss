QWidget {
    background: transparent;
    color: #E3E3E3;
}

QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0B0B0C, stop:1 #161618);
}

QDialog,
QMessageBox {
    background: #141416;
}

QWidget#root {
    background: transparent;
}

QWidget#titleBar {
    background: transparent;
}

QLabel#logoMark {
    background: #BEEE11;
    border-radius: 4px;
}

QLabel#appTitle {
    color: rgba(255, 255, 255, 0.75);
    font-size: 12px;
    font-weight: 600;
}

QWidget#sidebar {
    background: rgba(255, 255, 255, 0.02);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
}

QLabel#wordmark {
    color: #BEEE11;
    font-size: 13px;
    font-weight: 800;
    font-style: italic;
}

QLabel#microLabel {
    color: rgba(255, 255, 255, 0.40);
}

QLabel#displayTitle {
    color: #FFFFFF;
    font-size: 26px;
    font-weight: 700;
    font-style: italic;
}

QLabel#statValue {
    color: #FFFFFF;
    font-size: 26px;
    font-weight: 700;
    font-style: italic;
}

QLabel#statValueAccent {
    color: #BEEE11;
    font-size: 26px;
    font-weight: 700;
    font-style: italic;
}

QLabel#emptyState {
    color: rgba(255, 255, 255, 0.25);
    font-weight: 700;
}

QFrame#card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 7px;
}

QPushButton#nav {
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 9px 12px;
    text-align: left;
    color: rgba(255, 255, 255, 0.55);
}

QPushButton#nav:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #E3E3E3;
}

QPushButton#nav[active="true"] {
    background: rgba(190, 238, 17, 0.12);
    color: #BEEE11;
    font-weight: 700;
}

QPushButton#nav:disabled {
    color: rgba(255, 255, 255, 0.20);
}

QPushButton#primary {
    background: #BEEE11;
    color: #0A0A0A;
    font-weight: 800;
    border: none;
    border-radius: 7px;
    padding: 10px 18px;
}

QPushButton#primary:hover {
    background: #CDF52A;
}

QPushButton#primary:pressed {
    background: #A8D60C;
}

QPushButton#tab {
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 7px 14px;
    color: rgba(255, 255, 255, 0.55);
}

QPushButton#tab:hover {
    color: #E3E3E3;
}

QPushButton#tab:checked {
    background: #BEEE11;
    color: #0A0A0A;
    font-weight: 800;
}

QFrame#tabBar {
    background: rgba(10, 10, 10, 0.60);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
}

QLineEdit#taskInput {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
    padding: 10px 14px;
    color: #FFFFFF;
    selection-background-color: #BEEE11;
    selection-color: #0A0A0A;
}

QLineEdit#taskInput:focus {
    border: 1px solid rgba(190, 238, 17, 0.60);
    background: rgba(255, 255, 255, 0.07);
}

QLineEdit#taskInput::placeholder {
    color: rgba(255, 255, 255, 0.30);
}

QComboBox#priorityInput {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
    padding: 9px 12px;
    color: #E3E3E3;
    min-width: 96px;
}

QComboBox#priorityInput:hover {
    background: rgba(255, 255, 255, 0.08);
}

QComboBox#priorityInput::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background: #141416;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 7px;
    selection-background-color: rgba(190, 238, 17, 0.20);
    color: #E3E3E3;
    padding: 4px;
    outline: none;
}

QListWidget#taskList {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#taskList::item {
    background: transparent;
    border: none;
}

QListWidget#taskList::item:selected {
    background: transparent;
}

QWidget#taskRow {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 7px;
}

QWidget#taskRow:hover {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
}

QLabel#taskTitle {
    color: #FFFFFF;
    font-size: 14px;
}

QLabel#taskTitle[done="true"] {
    color: rgba(255, 255, 255, 0.35);
}

QLabel#chip {
    background: rgba(255, 255, 255, 0.06);
    border-radius: 5px;
    padding: 2px 7px;
    color: rgba(255, 255, 255, 0.60);
    font-size: 10px;
}

QLabel#chip[urgent="true"] {
    background: rgba(255, 85, 85, 0.14);
    color: #FF8A8A;
}

QPushButton#rowAction {
    background: transparent;
    border: none;
    border-radius: 7px;
    color: rgba(255, 255, 255, 0.30);
    font-size: 14px;
}

QPushButton#rowAction:hover {
    background: rgba(255, 85, 85, 0.16);
    color: #FF5555;
}

QCheckBox#doneBox::indicator {
    width: 17px;
    height: 17px;
    border-radius: 9px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: transparent;
}

QCheckBox#doneBox::indicator:hover {
    border: 1px solid rgba(190, 238, 17, 0.70);
}

QCheckBox#doneBox::indicator:checked {
    background: #BEEE11;
    border: 1px solid #BEEE11;
}

QProgressBar#progress {
    background: rgba(255, 255, 255, 0.06);
    border: none;
    border-radius: 3px;
    height: 5px;
    text-align: center;
}

QProgressBar#progress::chunk {
    background: #BEEE11;
    border-radius: 3px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.22);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

QToolTip {
    background: #141416;
    color: #E3E3E3;
    border: 1px solid rgba(255, 255, 255, 0.10);
    padding: 5px 8px;
}

/* ---------- kalender ---------- */

QPushButton#iconButton {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 15px;
}

QPushButton#iconButton:hover {
    background: rgba(255, 255, 255, 0.10);
    color: #FFFFFF;
}

QPushButton#secondary {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 7px;
    padding: 9px 14px;
    color: rgba(255, 255, 255, 0.88);
    font-weight: 600;
}

QPushButton#secondary:hover {
    background: rgba(255, 255, 255, 0.10);
}

QPushButton#danger {
    background: rgba(255, 85, 85, 0.14);
    border: 1px solid rgba(255, 85, 85, 0.28);
    border-radius: 7px;
    padding: 9px 14px;
    color: #FF8A8A;
    font-weight: 600;
}

QPushButton#danger:hover {
    background: rgba(255, 85, 85, 0.24);
}

QFrame#dayCell {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 7px;
}

QFrame#dayCell:hover {
    border: 1px solid rgba(255, 255, 255, 0.16);
}

QFrame#dayCell[inMonth="false"] {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.03);
}

QFrame#dayCell[today="true"] {
    border: 1px solid rgba(190, 238, 17, 0.45);
}

QFrame#dayCell[selected="true"] {
    background: rgba(190, 238, 17, 0.10);
    border: 1px solid rgba(190, 238, 17, 0.65);
}

QLabel#dayNumber {
    color: rgba(255, 255, 255, 0.65);
    font-size: 11px;
    font-weight: 700;
}

QFrame#dayCell[inMonth="false"] QLabel#dayNumber {
    color: rgba(255, 255, 255, 0.22);
}

QLabel#dayEntry {
    color: rgba(255, 255, 255, 0.78);
    font-size: 10px;
}

QLabel#dayEntryMore {
    color: rgba(255, 255, 255, 0.35);
    font-size: 10px;
}

QLabel#agendaTitle {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
}

QPushButton#agendaItem {
    background: rgba(255, 255, 255, 0.04);
    border-radius: 6px;
    padding: 7px 9px;
    text-align: left;
    color: #E3E3E3;
    font-size: 12px;
}

QPushButton#agendaItem:hover {
    background: rgba(255, 255, 255, 0.08);
}

QLabel#agendaEmpty {
    color: rgba(255, 255, 255, 0.30);
    font-size: 12px;
}

/* ---------- dialog event ---------- */

QLabel#dialogTitle {
    color: #FFFFFF;
}

QDialog QLabel {
    color: rgba(255, 255, 255, 0.55);
    font-size: 12px;
}

QLineEdit#field,
QComboBox#field,
QDateTimeEdit#field,
QSpinBox#field {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    padding: 7px 10px;
    color: #FFFFFF;
    min-height: 18px;
}

QLineEdit#field:focus,
QComboBox#field:focus,
QDateTimeEdit#field:focus,
QSpinBox#field:focus {
    border: 1px solid rgba(190, 238, 17, 0.60);
}

QCalendarWidget QAbstractItemView {
    background: #141416;
    color: #E3E3E3;
    selection-background-color: rgba(190, 238, 17, 0.25);
    selection-color: #FFFFFF;
}

/* ---------- komponen kustom: select & date field ---------- */

QFrame#select {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
}

QFrame#select:hover {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
}

QLabel#selectValue {
    color: #FFFFFF;
    font-size: 13px;
}

QLabel#selectChevron {
    color: rgba(255, 255, 255, 0.45);
    font-size: 10px;
}

QFrame#selectPopup {
    background: #161618;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
}

QPushButton#selectItem {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 8px 10px;
    text-align: left;
    color: #E3E3E3;
    font-size: 13px;
}

QPushButton#selectItem:hover {
    background: rgba(255, 255, 255, 0.08);
}

QPushButton#selectItem[current="true"] {
    color: #BEEE11;
    font-weight: 700;
}

QFrame#datePopup {
    background: #161618;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
}

QLabel#datePopupMonth {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
}

QLabel#datePopupWeekday {
    color: rgba(255, 255, 255, 0.35);
    font-size: 10px;
    font-weight: 700;
}

QPushButton#dateCell {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #E3E3E3;
    font-size: 12px;
}

QPushButton#dateCell[outside="true"] {
    color: rgba(255, 255, 255, 0.25);
}

QPushButton#dateCell:hover {
    background: rgba(255, 255, 255, 0.08);
}

QPushButton#dateCell:checked {
    background: #BEEE11;
    color: #0A0A0A;
    font-weight: 800;
}

QLabel#agendaHoliday {
    background: rgba(229, 193, 88, 0.10);
    border-left: 2px solid #E5C158;
    border-radius: 6px;
    padding: 7px 9px;
    color: #E5C158;
    font-size: 12px;
}

/* ---------- header dialog kustom ---------- */

QWidget#dialogHeader {
    background: transparent;
}

QLabel#dialogHeading {
    color: #FFFFFF;
}

QScrollArea#taskScroll {
    background: transparent;
    border: none;
}

QScrollArea#taskScroll > QWidget > QWidget {
    background: transparent;
}

/* ---------- rutinitas & kebiasaan ---------- */

QWidget#routineRow {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 7px;
}

QLabel#routineTitle {
    color: #E3E3E3;
}

QPushButton#miniButton {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 6px;
    padding: 4px 8px;
    color: rgba(255, 255, 255, 0.55);
    font-size: 10px;
    font-weight: 700;
}

QPushButton#miniButton:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #E3E3E3;
}

QPushButton#scheduleItem {
    background: rgba(255, 255, 255, 0.04);
    border: none;
    border-radius: 6px;
    padding: 8px 10px;
    text-align: left;
    color: #E3E3E3;
    font-size: 12px;
}

QPushButton#scheduleItem:hover {
    background: rgba(255, 255, 255, 0.08);
}

QPushButton#dayToggle {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 6px;
    padding: 5px 9px;
    color: rgba(255, 255, 255, 0.60);
    font-size: 10px;
    font-weight: 700;
}

QPushButton#dayToggle:checked {
    background: #BEEE11;
    border: 1px solid #BEEE11;
    color: #0A0A0A;
}

QLabel#habitStreak {
    color: rgba(255, 255, 255, 0.40);
    font-size: 11px;
}

QFrame#habitDot {
    background: rgba(255, 255, 255, 0.10);
    border-radius: 5px;
}

QFrame#habitDot[on="true"] {
    background: #BEEE11;
}

/* ---------- pengaturan ---------- */

QLabel#settingValue {
    color: #E3E3E3;
    font-size: 13px;
}

QLabel#settingNote {
    color: rgba(255, 255, 255, 0.35);
    font-size: 11px;
}

/* ---------- catatan ---------- */

QListWidget#noteList {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#noteList::item {
    padding: 7px 8px;
    border-radius: 6px;
    color: #E3E3E3;
    font-size: 12px;
}

QListWidget#noteList::item:hover {
    background: rgba(255, 255, 255, 0.06);
}

QListWidget#noteList::item:selected {
    background: rgba(190, 238, 17, 0.14);
    color: #FFFFFF;
}

QTextEdit#noteEditor {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 12px;
    color: #E3E3E3;
    font-size: 13px;
    selection-background-color: rgba(190, 238, 17, 0.30);
}

QTextEdit#noteEditor:focus {
    border: 1px solid rgba(190, 238, 17, 0.45);
}

/* ---------- pencarian global ---------- */

QLineEdit#searchField {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 11px 14px;
    color: #FFFFFF;
    font-size: 14px;
    selection-background-color: #BEEE11;
    selection-color: #0A0A0A;
}

QLineEdit#searchField:focus {
    border: 1px solid rgba(190, 238, 17, 0.55);
}

QListWidget#searchResults {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#searchResults::item {
    padding: 8px 10px;
    border-radius: 6px;
    color: #E3E3E3;
    font-size: 13px;
}

QListWidget#searchResults::item:hover {
    background: rgba(255, 255, 255, 0.06);
}

QListWidget#searchResults::item:selected {
    background: rgba(190, 238, 17, 0.14);
    color: #FFFFFF;
}

QLabel#searchHint {
    color: rgba(255, 255, 255, 0.30);
    font-size: 11px;
}
